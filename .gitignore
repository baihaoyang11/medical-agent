# Milvus向量库文件、临时锁
*.db
*.db.lock
# Python编译缓存
__pycache__/
*.pyc
*.pyo
# 大型医学PDF教材
*.pdf
pdf_documents/
# 教材抽取产物：含教材正文，受版权保护，禁止入库
pdf_output/
# 密钥、配置
.env
.env.local
settings.json
*.key
# 缓存、日志
cache/
logs/
*.log
venv/
.venv/
# 数据集、病历隐私文件
# 注意：整个 data/ 忽略会把 data/README.md 也排掉，所以用「忽略内容 + 保留说明」
data/*
!data/README.md
dataset/
patient_data/
# 测试与构建产物
test_report.json
*.report.json
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
# 评测原始输出（含每条 query 的完整排序，约 470K）
# 聚合结论已写进 eval/report.md，原始数据本地重跑即可
eval/results.json
eval/route_audit.json
eval/dual_results.json

# hashing 快速校验的产物（CI 用）。
# 它只验证"管线能跑通"，不是效果结论 —— 不提交，也不允许覆盖 bge 的报告。
# 之前 CI 用同一个文件名写回，导致仓库里的 report.md 是 hashing 分数、
# 而 FINDINGS.md 引用 bge 分数，两者对不上。
eval/report-hashing.md
eval/results-hashing.json
eval/route_audit-hashing.md
eval/route_audit-hashing.json
eval/dual_report-hashing.md
eval/dual_results-hashing.json

# 编辑器配置（含本机解释器绝对路径，不进仓库）
.vscode/
