# 复制为 .env 后填入真实值：cp .env.example .env

# ===== 必填：模型 API Key =====
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=

# ===== 模型参数 =====
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
# 医疗问答建议 0 ~ 0.2，越高越发散
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# ===== 检索参数 =====
# 单次检索最多再补几次（总检索次数 = 该值 + 1）
MAX_SECONDARY_SEARCH=2
UPSTREAM_RETRIES=2
RETRY_BASE_DELAY=0.4

# ===== 向量库路径 =====
# 生产环境请换成 Milvus 服务地址，不要用本地文件模式
# 注意：WSL 下必须用 Linux 原生路径（/tmp、/home/...），用 /mnt/d/... 会因文件锁失败
MILVUS_QA_URI=./data/milvus_agent.db
MILVUS_PDF_URI=./data/pdf_agent.db

# ===== 重排 =====
# noop（关闭）/ keyword（零依赖，默认）/ cross_encoder（需本地模型）
RERANK_STRATEGY=keyword
# cross_encoder 策略必填；留空或加载失败会自动降级到 keyword，服务不受影响
RERANK_MODEL_PATH=
# 关键词覆盖率在原排名分中的权重倾向：越高越看重词面重合
RERANK_WEIGHT=0.6

# ===== 检索器路由 =====
# 全局默认检索器：hybrid（默认）/ dense / sparse
# 评测显示单库上 dense 明显更强（R@5 0.974 vs 0.905），但生产是双库，
# 先在双库补对照再改这里。改这一行就是全部改动，不用动代码。
RETRIEVER_DEFAULT=hybrid
# 按问题类型切换检索器（默认关闭）。
# 关闭原因见 eval/route_audit.md：现有分类器 57.8% 的请求落进 general 兜底，
# 真实路由 R@5 0.931 打不过统一 dense 的 0.974。
RETRIEVER_ROUTING=false

# ===== 离线入库 =====
# 一次 embedding 请求提交多少条文本（智谱 embedding-3 单次建议 ≤ 64）
EMBED_BATCH_SIZE=32

# ===== 安全 =====
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 留空表示不启用 API Key 认证（仅建议本地开发）
API_KEYS=
AUTH_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
MAX_INPUT_LENGTH=2000

# ===== 服务 =====
HOST=0.0.0.0
PORT=8103
LOG_LEVEL=INFO
